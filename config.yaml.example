#-------------------核心配置-----------------
# 极速模式 (True/False)
# True: 使用 API 直接检测，速度快但不包含 Bot 比例
# False: IPPure 使用浏览器检测并提供 Bot 比例；Ping0 仍使用 API
fast_mode: True

# 你的 Clash 配置文件绝对路径 例如 'C:\Users\YourName\AppData\Roaming\clash\config.yaml'
yaml_path: ''

# Clash External Controller 外部控制地址
clash_api_url: "http://127.0.0.1:9097"

# Clash External Controller 外部控制密码 (如果没设置密码留空即可)
clash_api_secret: ""


#-------------------可选配置-----------------

# 检测源 (both、ping0 或 ippure), 默认 both
# both: 同时检测 Ping0 和 IPPure，分别显示两家结果
# ping0 / ippure: 检测指定主源；降级限制见下方说明
source: "both"

# 是否允许降级 (True/False), 默认 True
# 单源极速检测：True 表示主源失败时尝试另一家；整体限时 3 秒
# IPPure 单源浏览器检测失败或超时后，True 表示用 Ping0 极速检测作为备用，另限时 3 秒
fallback: true


# 输出配置文件后缀
output_suffix: "_checked"

# 全局代理组名称 (通常默认是 GLOBAL 或 Proxy)
selector_name: "GLOBAL"

# 非极速的浏览器模式下是否隐藏浏览器窗口 (True/False)
# True: 隐藏 (后台运行)
# False: 显示 (调试用)
headless: true

# Node跳过检测的关键字列表
skip_keywords:
  - "剩余"
  - "重置"
  - "到期"
  - "有效期"
  - "官网"
  - "网址"
  - "更新"
  - "公告"
  - "建议"

